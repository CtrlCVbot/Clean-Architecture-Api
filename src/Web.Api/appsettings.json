{
  "AppSettings": {
    "WebpagesVersion": "1.0.0.0",
    "WebpagesEnabled": false,
    "ClientValidationEnabled": true,
    "UnobtrusiveJavaScriptEnabled": true,
    "LogUseFlag": "Y",
    "FilePath": "/UploadFiles",
    "LogDirectory": "C:\\API_Server\\Front_API\\LOG\\LogFiles\\"
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "MainDbConnectionString": "Server=localhost;Database=PL_Main;User ID=ctrlcvbot; Password=012027;Trusted_Connection=True; TrustServerCertificate=True;",
    "MemberDbConnectionString": "Server=localhost;Database=PL_Member;User ID=ctrlcvbot; Password=012027;Trusted_Connection=True; TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },


  "Authentication": {
    "Jwt": {
      "Issuer": "https://localhost:7253/",
      "Audience": "https://localhost:7253/",
      "SecretKey": "",
      "TokenLifetimeMinutes": 60
    }
  },

  "ApplicationSettings": {
    "Environment": "Development",
    "EnableSwagger": true,
    "MaxUploadFileSizeMB": 50
  },

  "Messaging": {
    "RabbitMQ": {
      "Host": "localhost",
      "Port": 5672,
      "UserName": "guest",
      "Password": "guest",
      "ExchangeName": "shipper_exchange"
    }
  },

  "FileStorage": {
    "S3": {
      "BucketName": "shipper-bucket",
      "AccessKey": "your-access-key",
      "SecretKey": "your-secret-key",
      "Region": "us-east-1"
    }
  },

  "LoggingSettings": {
    "EnableFileLogging": true,
    "LogDirectory": "/logs",
    "LogLevel": "Information"
  },

  "CacheSettings": {
    "Redis": {
      "Enabled": true,
      "ConnectionString": "localhost:6379"
    }
  },

  "ExternalApis": {
    "Unipass": {
      "BaseUrl": "https://unipass.customs.go.kr",
      "ApiKey": "your-unipass-api-key"
    },
    "PortInfo": {
      "BaseUrl": "https://portinfo.api.com",
      "ApiKey": "your-portinfo-api-key"
    }
  },

  "BackgroundJobs": {
    "EnableWorker": true,
    "Schedule": "0 */5 * * * *" 
  }
}

